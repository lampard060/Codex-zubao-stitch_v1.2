{
  "name": "zubao-api-server",
  "version": "0.1.0",
  "private": true,
  "description": "ZuBao MVP API server",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "db:schema": "node scripts/run-sql-file.js ../db/mvp_schema.sql",
    "db:upgrade:masterdata": "node scripts/run-sql-file.js ../db/mvp_masterdata_upgrade.sql",
    "db:seed": "node scripts/run-sql-file.js ../db/mvp_seed.sql",
    "smoke": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  }
}
